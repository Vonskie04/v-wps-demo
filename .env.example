# Server-side credentials; copy values from your local environment.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_MEDIA_FOLDER=ems-sage
CLOUDINARY_RESOURCE_CACHE_MS=0
MEDIA_LIST_PORT=8788
MAX_UPLOAD_BYTES=262144000
PURCHASED=TRUE
ACCESS_TOKEN=
ADMIN_TOKEN=
MASTER_TOKEN=
MASTER_KEY=

# Optional remote persistence (otherwise moderation is saved locally).
STORE_URL=
STORE_TOKEN=

# Optional Vite proxy override; defaults to MEDIA_LIST_PORT.
# API_SERVER=http://localhost:8788
